#!/usr/bin/env bash

icon=""
brightness=$(light)
current=$(printf "%.0f" $brightness)

if [[ ("$current" -ge "0") && ("$LIGHT" -le "25") ]]; then
	echo "^C3^  󰃞 ^d^ $current%"
elif [[ ("$current" -ge "25") && ("$LIGHT" -le "50") ]]; then
	echo "^C3^  󰃟 ^d^ $current%"
elif [[ ("$current" -ge "50") && ("$LIGHT" -le "75") ]]; then
	echo "^C3^  󰃝 ^d^ $current%"
elif [[ ("$current" -ge "75") && ("$LIGHT" -le "100") ]]; then
	echo "^C3^  󰃠 ^d^ $current%"
fi

case "$BLOCK_BUTTON" in
	4) /usr/share/archcraft/dwm/scripts/dwm_brightness --inc ;;
    5) /usr/share/archcraft/dwm/scripts/dwm_brightness --dec ;;
esac
