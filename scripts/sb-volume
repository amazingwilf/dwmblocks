#!/usr/bin/env bash


case "$BLOCK_BUTTON" in
    1) setsid --fork pavucontrol ;;
    3) volume --toggle ;;
    4) volume --inc ;;
    5) volume --dec ;;
esac
icon=""
current=`pulsemixer --get-volume | cut -d' ' -f1`
status=`pulsemixer --get-mute`

if [[ "$status" -eq "1" ]]; then
    echo "^C8^󰖁 ^d^Muted"
else
    echo "^C2^$icon  ^d^$current%"
fi
