#!/usr/bin/env bash


case "$BLOCK_BUTTON" in
    1) setsid --fork pavucontrol ;;
    3) /usr/share/archcraft/dwm/scripts/dwm_volume --toggle ;;
    4) /usr/share/archcraft/dwm/scripts/dwm_volume --inc ;;
    5) /usr/share/archcraft/dwm/scripts/dwm_volume --dec ;;
esac
icon=""
current=`pulsemixer --get-volume | cut -d' ' -f1`
status=`pulsemixer --get-mute`

if [[ "$status" -eq "1" ]]; then
    echo "^c#454545^󰖁 ^d^Muted"
else
    echo "^c#c678dd^$icon  ^d^$current%"
fi
